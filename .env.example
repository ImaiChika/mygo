APP_NAME=mygo
APP_ENV=dev
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

POSTGRES_ENABLED=true
POSTGRES_DSN=postgres://mygo:mygo@127.0.0.1:5432/mygo?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

REDIS_ENABLED=true
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

AUTH_ACCESS_SECRET=change-me
AUTH_COLLAB_SECRET=change-me-too
AUTH_ACCESS_TTL=24h

WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_UPLOAD_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8080
STORAGE_MAX_FILE_SIZE=10485760
